# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAPIDAPI_KEY: Optional RapidAPI key for Cricket Data and Live Sports Feeds
RAPIDAPI_KEY="MY_RAPIDAPI_KEY"

# THESPORTSDB_API_KEY: TheSportsDB API key (defaults to free tier '3')
THESPORTSDB_API_KEY="3"

# ALLSPORTSAPI_KEY: Optional API key from AllSportsAPI.com for Football, Cricket, Basketball, Tennis live scores & fixtures
ALLSPORTSAPI_KEY=""

# SOFASCORE_API_KEY: Optional RapidAPI SofaScore key for live scores, fixtures & stats across sports
SOFASCORE_API_KEY=""
SOFASCORE_RAPIDAPI_HOST="sofascore.p.rapidapi.com"

# CRICBUZZ_RAPIDAPI_HOST: RapidAPI Cricbuzz host (defaults to cricbuzz-cricket2.p.rapidapi.com)
CRICBUZZ_RAPIDAPI_HOST="cricbuzz-cricket2.p.rapidapi.com"

# SPORTRADAR_CRICKET_API_KEY: Optional Sportradar Cricket API key (Trial or Production)
SPORTRADAR_CRICKET_API_KEY=""

# SPORTRADAR_CRICKET_TIER: Sportradar Cricket tier ('t2' for Trial, 'p2' or 'v2' for Production)
SPORTRADAR_CRICKET_TIER="t2"
